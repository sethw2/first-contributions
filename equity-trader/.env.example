# Copy to `.env` and fill in. NEVER commit real keys.
# The system reads secrets from the environment ONLY — never from YAML.

# Alpaca API credentials.
# For PAPER trading, create paper keys at https://app.alpaca.markets/ (Paper account).
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Optional: force paper mode regardless of config (belt-and-suspenders).
# FORCE_PAPER=true
