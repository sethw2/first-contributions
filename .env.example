# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# All secrets come from the environment; nothing sensitive is committed.

# --- Execution mode -------------------------------------------------------
# Default is paper. Live requires EVERY switch below plus an explicit runtime
# arm step and per-session confirmation (see src/equities/config.py, SAFETY.md).
EQUITIES_MODE=paper

# Master live-trading switch. Must be exactly "1" AND accompanied by the other
# switches for any real-money order to be possible. Keep this "0".
EQUITIES_ALLOW_LIVE=0

# --- Alpaca (paper broker, development default) ---------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- TradeStation (REST/OAuth, live path) ---------------------------------
TRADESTATION_CLIENT_ID=
TRADESTATION_CLIENT_SECRET=
TRADESTATION_REFRESH_TOKEN=
TRADESTATION_ACCOUNT_ID=
# Use the simulation endpoint until live is deliberately armed.
TRADESTATION_BASE_URL=https://sim-api.tradestation.com

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
